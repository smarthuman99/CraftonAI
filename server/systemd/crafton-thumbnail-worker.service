[Unit]
Description=Crafton private product and drawing thumbnails
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crafton-ai
ExecStart=/usr/bin/node --env-file-if-exists=server/.env server/portal-thumbnail-worker.mjs
Restart=always
RestartSec=5
Nice=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
