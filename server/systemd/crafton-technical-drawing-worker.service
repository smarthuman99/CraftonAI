[Unit]
Description=Crafton furniture technical drawing worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crafton-ai
ExecStart=/usr/bin/node --env-file-if-exists=server/.env server/technical-drawing-worker.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
