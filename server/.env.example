SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. If omitted, the worker uses deterministic local parsing so the pipeline can be tested without AI spend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional but required for automatic JPG/PNG/WebP understanding in Intake Worker.
# Images are sent as inline base64 to Gemini Interactions API; keep the byte limit below the API's 20 MB request limit.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_API_REVISION=2026-05-20
GEMINI_VISION_TIMEOUT_MS=60000

# Optional but required for automatic client-facing furniture three-view drawings.
# Draft and formal SVG sheets are composed locally; Gemini only generates the orthographic visual.
THREE_VIEW_MODEL=gemini-3.1-flash-image
THREE_VIEW_IMAGE_SIZE=2K
THREE_VIEW_TIMEOUT_MS=180000
THREE_VIEW_WORKER_INTERVAL_MS=12000
THREE_VIEW_WORKER_SCAN_LIMIT=30
THREE_VIEW_MAX_ATTEMPTS=3
THREE_VIEW_MAX_REFERENCE_IMAGES=4
THREE_VIEW_STALE_MINUTES=30
# Public client-portal base URL encoded into technical-drawing tracking QR codes.
THREE_VIEW_PUBLIC_APP_URL=http://129.121.98.185/

# AI customer service chat endpoint. Runs locally and keeps the model API key server-side.
AI_SUPPORT_PORT=8787
AI_SUPPORT_MODEL=deepseek-v4-flash
AI_SUPPORT_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AI_SUPPORT_MODEL_TIMEOUT_MS=45000
AI_SUPPORT_MODEL_MAX_RETRIES=2
INTAKE_REANALYSIS_MODEL=deepseek-v4-flash
INTAKE_REANALYSIS_TIMEOUT_MS=120000
INTAKE_REANALYSIS_MAX_TOKENS=8000
INTAKE_REANALYSIS_MAX_SOURCE_BYTES=31457280
INTAKE_REANALYSIS_MAX_SOURCE_CHARS=50000
AI_RFQ_MODEL=deepseek-v4-flash
AI_RFQ_MODEL_TIMEOUT_MS=60000

# Supplier RFQ delivery. Resend is used only after Cho approves and clicks send.
RESEND_API_KEY=
RFQ_FROM_EMAIL="Crafton Sourcing <rfq@thecrafton.com>"
RFQ_REPLY_TO=

# Worker behavior
INTAKE_WORKER_INTERVAL_MS=8000
INTAKE_WORKER_BATCH_SIZE=1
INTAKE_WORKER_MAX_ATTEMPTS=3
INTAKE_WORKER_MAX_FILE_TEXT_CHARS=12000
INTAKE_VISION_MAX_FILE_BYTES=12582912
INTAKE_DOCUMENT_MAX_FILE_BYTES=262144000
INTAKE_PDF_BATCH_PAGES=4
INTAKE_PDF_BATCH_RETRIES=2
# Render low-text PDF pages for Gemini vision. Defaults are tuned for FF&E schedules with outlined or scanned text.
INTAKE_PDF_VISUAL_FALLBACK_MIN_TEXT_CHARS_PER_PAGE=80
INTAKE_PDF_VISUAL_FALLBACK_RENDER_WIDTH=1400
INTAKE_WORKER_STALE_MINUTES=30
LIBREOFFICE_BIN=soffice
INTAKE_XLS_CONVERSION_TIMEOUT_MS=60000
