SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. If omitted, the worker uses deterministic local parsing so the pipeline can be tested without AI spend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# AI customer service chat endpoint. Runs locally and keeps the model API key server-side.
AI_SUPPORT_PORT=8787
AI_SUPPORT_MODEL=deepseek-v4-flash
AI_SUPPORT_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AI_SUPPORT_MODEL_TIMEOUT_MS=45000
AI_SUPPORT_MODEL_MAX_RETRIES=2
AI_RFQ_MODEL=deepseek-v4-flash
AI_RFQ_MODEL_TIMEOUT_MS=60000

# Supplier RFQ delivery. Resend is used only after Cho approves and clicks send.
RESEND_API_KEY=
RFQ_FROM_EMAIL="Crafton Sourcing <rfq@thecrafton.com>"
RFQ_REPLY_TO=

# Worker behavior
INTAKE_WORKER_INTERVAL_MS=8000
INTAKE_WORKER_BATCH_SIZE=1
INTAKE_WORKER_MAX_ATTEMPTS=3
