{
  "name": "crafton-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "report:build": "node scripts/build-self-contained-report.mjs",
    "lint": "eslint src/app.jsx src/main.jsx src/components --report-unused-disable-directives --max-warnings 0",
    "test:intake": "node --test server/lib/intakeProcessor.test.mjs server/lib/intakeSourceReader.test.mjs server/lib/intakeBatchProcessor.test.mjs",
    "test:rfq": "node --test server/lib/rfqGenerator.test.mjs",
    "test:rfq-excel": "node --test server/lib/rfqExcel.test.mjs",
    "test:workflow-ai": "node --test server/lib/quoteAnalyzer.test.mjs server/lib/operationsAutomation.test.mjs",
    "format": "prettier --write .",
    "support:ai": "node --env-file-if-exists=server/.env server/ai-support-server.mjs",
    "worker:intake": "node --env-file-if-exists=server/.env server/intake-worker.mjs",
    "worker:intake:once": "node --env-file-if-exists=server/.env server/intake-worker.mjs --once",
    "worker:drawing": "node --env-file-if-exists=server/.env server/technical-drawing-worker.mjs",
    "worker:drawing:once": "node --env-file-if-exists=server/.env server/technical-drawing-worker.mjs --once",
    "prepare": "husky install"
  },
  "dependencies": {
    "@eredzik/calaminejs": "^0.2.0",
    "@supabase/supabase-js": "^2.43.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.61.0",
    "prettier": "^3.5.1",
    "vite": "^5.2.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
