{
  "name": "crafton-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/app.jsx src/main.jsx src/components --report-unused-disable-directives --max-warnings 0",
    "test:intake": "node --test server/lib/intakeProcessor.test.mjs",
    "test:rfq": "node --test server/lib/rfqGenerator.test.mjs",
    "format": "prettier --write .",
    "support:ai": "node --env-file-if-exists=server/.env server/ai-support-server.mjs",
    "worker:intake": "node --env-file-if-exists=server/.env server/intake-worker.mjs",
    "worker:intake:once": "node --env-file-if-exists=server/.env server/intake-worker.mjs --once",
    "prepare": "husky install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.61.0",
    "prettier": "^3.5.1",
    "vite": "^5.2.11"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
